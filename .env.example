# Supabase project settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). The legacy NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...), server-only. The legacy SUPABASE_SERVICE_ROLE_KEY is also accepted.
SUPABASE_SECRET_KEY=

# Public site URL used in auth email links (password reset, confirmation).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI mentor (optional: everything else works without it).
GROQ_API_KEY=
# Any chat model your Groq account supports.
GROQ_MODEL=llama-3.3-70b-versatile
